{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfold",
  "version": "1.0.0",
  "identifier": "com.unfold.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unfold",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "A private visual space for connected clues",
    "longDescription": "Unfold is a local-first black canvas for arranging notes, photos, files, and the connections between them.",
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false }
  }
}
